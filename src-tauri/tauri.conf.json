{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-monitor",
  "version": "0.2.2",
  "identifier": "com.desktopmonitor.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/plugins/device-battery/*",
      "resources/plugins/sys-collector/*"
    ],
    "publisher": "desktop-monitor",
    "category": "Utility",
    "shortDescription": "Desktop metrics panel: cards on the desktop, floating HUD and taskbar strip",
    "longDescription": "desktop-monitor shows system metrics as cards pinned to the desktop, a floating HUD and a taskbar strip. Data comes from pluggable collectors (C#/.NET).",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0OTBFREM5OUI0ODMwQTgKUldTb01FaWJ5ZTJReEFYQ1FTclJpNUdxM1hBS0dCRDUvSVJ1VzZnSG5McG5jYkFxMUR2WVJzc2cK",
      "endpoints": [
        "https://github.com/Code-Agitator/desktop-monitor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
